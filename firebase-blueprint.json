{
  "entities": {
    "UserBackup": {
      "title": "UserBackup",
      "description": "Cloud backup of user application state (campaigns, settings, templates, contacts summary)",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the owner",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "payloadJson": {
          "type": "string",
          "description": "Serialized backup state for synchronization across devices",
          "minLength": 2,
          "maxLength": 900000
        },
        "deviceLabel": {
          "type": "string",
          "description": "Device or platform identifier",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp"
        }
      },
      "required": ["ownerId", "payloadJson", "deviceLabel", "createdAt", "updatedAt"]
    },
    "UserPushToken": {
      "title": "UserPushToken",
      "description": "FCM device token associated with a user for push notifications",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "User identifier or Firebase UID",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fcmToken": {
          "type": "string",
          "description": "Firebase Cloud Messaging device registration token",
          "minLength": 10,
          "maxLength": 4096
        },
        "platform": {
          "type": "string",
          "description": "Device platform (android, ios, web)",
          "minLength": 2,
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Registration server timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last token refresh server timestamp"
        }
      },
      "required": ["ownerId", "fcmToken", "platform", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/user_backups/{userId}": {
      "schema": { "$ref": "#/entities/UserBackup" },
      "description": "Stores per-user cloud backup document keyed by the authenticated user's UID"
    },
    "/user_push_tokens/{userId}": {
      "schema": { "$ref": "#/entities/UserPushToken" },
      "description": "Stores per-user FCM device token keyed by the authenticated user's UID"
    }
  }
}
