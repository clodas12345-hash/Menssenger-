rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidSyncKey(key) {
      return key is string && key.size() >= 3 && key.size() <= 128 && key.matches('^[a-zA-Z0-9_\\-\\.\\@]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserBackup(data, userId) {
      return data.keys().hasAll(['ownerId', 'payloadJson', 'deviceLabel', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'payloadJson', 'deviceLabel', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.payloadJson is string
        && data.payloadJson.size() >= 2
        && data.payloadJson.size() <= 900000
        && data.deviceLabel is string
        && data.deviceLabel.size() >= 1
        && data.deviceLabel.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCloudBackup(data, syncKey) {
      return data.keys().hasAll(['syncKey', 'payloadJson', 'deviceLabel', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['syncKey', 'payloadJson', 'deviceLabel', 'createdAt', 'updatedAt'])
        && data.syncKey is string
        && data.syncKey.size() >= 3
        && data.syncKey.size() <= 128
        && data.syncKey.matches('^[a-zA-Z0-9_\\-\\.\\@]+$')
        && data.syncKey == syncKey
        && data.payloadJson is string
        && data.payloadJson.size() >= 2
        && data.payloadJson.size() <= 900000
        && data.deviceLabel is string
        && data.deviceLabel.size() >= 1
        && data.deviceLabel.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPushToken(data, userId) {
      return data.keys().hasAll(['ownerId', 'fcmToken', 'platform', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'fcmToken', 'platform', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.ownerId.size() >= 1
        && data.ownerId.size() <= 128
        && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.ownerId == userId
        && data.fcmToken is string
        && data.fcmToken.size() >= 10
        && data.fcmToken.size() <= 4096
        && data.platform is string
        && data.platform.size() >= 1
        && data.platform.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /user_backups/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserBackup(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserBackup(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['payloadJson', 'deviceLabel', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /cloud_backups/{syncKey} {
      allow get: if isValidSyncKey(syncKey);
      allow list: if false;
      allow create: if isValidSyncKey(syncKey)
        && isValidCloudBackup(incoming(), syncKey)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidSyncKey(syncKey)
        && isValidCloudBackup(incoming(), syncKey)
        && incoming().syncKey == existing().syncKey
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['payloadJson', 'deviceLabel', 'updatedAt']);
      allow delete: if false;
    }

    match /user_push_tokens/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserPushToken(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserPushToken(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['fcmToken', 'platform', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);
    }
  }
}
